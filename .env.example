# Configuración de MongoDB Atlas para Estación IoT
# Copiar este archivo como .env y completar con tus credenciales

MONGODB_URI=mongodb+srv://<usuario>:<password>@test.nz1tmu4.mongodb.net/estacion-iot
MONGODB_DB_NAME=estacion-iot
MONGODB_COLLECTION=lecturas
# Intervalo de guardado en segundos por cada dispositivo conectado (300s = 5 minutos)
MONGODB_INTERVALO_SEGUNDOS=300
